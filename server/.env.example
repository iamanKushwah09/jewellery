# Server Configuration
PORT=5056
NODE_ENV=development
BASE_URL=http://localhost:5056
STORE_DOMAIN=https://logicfirst.in
FILE_UPLOAD_FOLDER=../uploadFile

# Database Configuration
MONGO_URI=mongodb://localhost:27017/logicfirstadmin

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_SECRET_FOR_VERIFY=your_verification_secret_key_here
JWT_EXPIRES_IN=24h

# Redis Configuration (For BullMQ GMC Sync Queue)
# If Redis is not available, the system automatically uses an in-memory queue fallback
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://127.0.0.1:6379

# Google Merchant Center (GMC) Configuration
# 1. Option A: Service Account JSON Key File
GMC_MERCHANT_ID=123456789
GMC_SERVICE_ACCOUNT_KEY_PATH=./config/gmc-service-account.json

# 2. Option B: Inline Service Account Credentials (Ideal for Cloud/Docker/Vercel/Render)
# GMC_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GMC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GMC Product Target Settings
GMC_FEED_LABEL=IN
GMC_TARGET_COUNTRY=IN
GMC_CONTENT_LANGUAGE=en
GMC_API_TIMEOUT=15000
GMC_CONCURRENCY=5

# Cloudinary (Optional image CDN)
# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
